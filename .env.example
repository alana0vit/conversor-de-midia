# Copie para .env se quiser alterar algum valor (opcional: o compose já tem padrões).

# RabbitMQ
RABBITMQ_USER=conversor
RABBITMQ_PASSWORD=conversor123

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
UPLOADS_BUCKET=uploads
CONVERTED_BUCKET=converted
CONVERTED_EXPIRATION_DAYS=7
# Endereço que o NAVEGADOR usa para abrir os links (diferente de http://minio:9000,
# que só existe dentro da rede do Docker)
MINIO_PUBLIC_URL=http://localhost:9000

# PostgreSQL
POSTGRES_DB=conversor
POSTGRES_USER=conversor
POSTGRES_PASSWORD=conversor123

# Worker (usado na próxima etapa)
WORKER_REPLICAS=2
MAX_UPLOAD_MB=20
MAX_ATTEMPTS=3
RETRY_DELAY_MS=5000
# Atraso artificial por conversão: PNG->JPG leva milissegundos, o que impede
# demonstrar "derrubar o worker no meio" e medir 1 vs N workers.
CONVERSION_DELAY_SECONDS=8

# E-mail -------------------------------------------------------------------
# Padrão (não precisa configurar): Mailpit, caixa de teste em http://localhost:8025
# Para enviar para a caixa de entrada de verdade, ex. com uma conta Gmail:
#   1. ative a verificação em duas etapas na conta Google;
#   2. gere uma "senha de app" em https://myaccount.google.com/apppasswords
#   3. descomente e preencha as linhas abaixo; depois: docker compose up -d
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=seu.email@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# SMTP_FROM=Conversor de Mídia <seu.email@gmail.com>
